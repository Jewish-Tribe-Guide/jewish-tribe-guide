# react/react-dom are pinned to a React canary build (see package.json) so
# React's <ViewTransition> component — used for the app's directional
# navigation animations — is actually available; it isn't exported by any
# stable React 19 release yet.
#
# Next.js's own peerDependencies range for react/react-dom hasn't been
# updated to allow current canary snapshots (it only special-cases one
# specific RC from December 2024), so a plain `npm install` fails outright
# with a real ERESOLVE conflict, not just a warning — both against next
# itself and against @testing-library/react's own peer range.
# legacy-peer-deps=true is what lets installs succeed despite that.
#
# One real side effect of legacy-peer-deps: its resolver silently drops
# @testing-library/dom from the tree entirely on a clean install (confirmed
# by deleting node_modules + package-lock.json and reinstalling from
# scratch — not a one-off glitch). @testing-library/dom has no dependency on
# React at all, so this isn't a peer conflict being (correctly) refused —
# it's the legacy resolver mishandling an unrelated transitive package. See
# @testing-library/dom's own explicit devDependency entry in package.json,
# which routes around that rather than leaving it to this resolution path.
#
# Remove this file and swap react/react-dom back to a stable release if the
# ViewTransition-based navigation is ever removed — the
# @testing-library/dom pin can come out at the same time, once it's back to
# being resolved normally.
legacy-peer-deps=true
