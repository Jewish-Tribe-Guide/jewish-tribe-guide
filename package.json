{
  "name": "jewish-patient-connect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "node scripts/test-db.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "setup": "node --env-file=.env.local scripts/setup.mjs",
    "migrations:report": "node --env-file=.env.local scripts/migration-report.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "doctor": "node --env-file=.env.local scripts/doctor.mjs",
    "backup": "node --env-file=.env.local scripts/backup.mjs",
    "sentry:check": "node --env-file=.env.local scripts/sentry-check.mjs",
    "import": "node --env-file=.env.local scripts/import.mjs",
    "sync-dev-from-prod": "node --env-file=.env.local scripts/sync-dev-from-prod.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:seed": "node scripts/test-e2e-seed.mjs",
    "test:cache-roundtrip": "playwright test --config playwright.cache.config.ts",
    "test:form-roundtrip": "playwright test --config playwright.form.config.ts",
    "test:admin-write": "playwright test --config playwright.admin-write.config.ts",
    "test:all": "vitest run && playwright test",
    "test:everything": "node scripts/test-everything.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "11.15.0",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "^2.119.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "next": "16.4.6",
    "playwright-core": "1.63.0",
    "posthog-js": "^1.453.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.39.0",
    "sharp": "^0.35.4",
    "tz-lookup": "^6.1.25",
    "unpdf": "2.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/google.maps": "^3.67.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "knip": "6.47.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
