# ── Supabase (resource directory + submission/moderation pipeline) ────────────
# Create a free project at supabase.com, then find these under:
#   Project Settings → API
# The URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# The service-role key is SECRET — server-side only, never prefixed NEXT_PUBLIC_.
# It bypasses Row-Level Security and is used by route handlers to write/moderate.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# ── The hosted test project (dev) ─────────────────────────────────────────────
# A second, hosted Supabase project for local dev and the Vercel previews,
# named again here so scripts that mean it can check they have it:
# sync-dev-from-prod writes only where NEXT_PUBLIC_SUPABASE_URL equals this,
# and run-test-watches reads it. The test suites never use it: they run on a
# local Supabase (`npm run test:db`), and refuse anything else.
TEST_SUPABASE_URL=https://your-test-project-ref.supabase.co
TEST_SUPABASE_ANON_KEY=your-test-project-anon-public-key
TEST_SUPABASE_SERVICE_ROLE_KEY=your-test-project-service-role-key

# Comma-separated emails for the standalone superadmin console at /admin
# (cross-community actions: creating a community, and a few site-wide
# singletons) — NOT the same as a community's own `admin_emails` (a
# database column, edited from the Communities tab's "Edit admins", that
# controls sign-in to THAT community's own /{slug}/admin console). This env
# var is also the fallback admin list for a community that hasn't set its
# own admin_emails yet.
SUPERADMIN_EMAILS=you@example.com

# Comma-separated emails allowed to access the /inbox form-response viewer.
# Separate from SUPERADMIN_EMAILS on purpose — being an admin doesn't grant inbox
# access, and vice versa. A person can be on both lists.
INBOX_EMAILS=you@example.com

# ── Google Maps (address autocomplete + resource map) ────────────────────────
# Enable BOTH the "Places API" and the "Maps JavaScript API" in your Google
# Cloud project, then restrict the key to your domain. If omitted, address
# fields fall back to plain text inputs and the resource map shows a notice.
# This same key powers the autocomplete in the resource Add/Edit forms (which
# capture the selected place's coordinates client-side) and the interactive
# Resource map (the "View map" card on the home screen).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-api-key
# A Cloud-console Map ID (Google Maps Platform > Map Management > Create Map ID;
# type JavaScript, renderer Vector). Required for real by AdvancedMarkerElement,
# which is what draws every pin, and it is also the ONLY way to restyle the
# basemap — with a Map ID set the JS `styles` option is ignored, so the map's
# look is whatever style you attach to this ID in the console. Leaving it unset
# falls back to a placeholder string that Google reports as "Map ID not found";
# pins still render today, but Google's own response warns that may change.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# Optional SERVER-side geocoding key (NO referrer restriction; restrict to the
# Geocoding API and/or your server IP instead). Used only when a submission has
# no client-captured coordinates (free-typed address or the backfill script).
# If omitted, server geocoding falls back to free OpenStreetMap/Nominatim.
GOOGLE_GEOCODING_API_KEY=your-unrestricted-geocoding-key

# ── Google Search Console (optional) ──────────────────────────────────────────
# Proves ownership so you can submit the sitemap and see real search
# performance data. In Search Console: Add property → URL prefix → your
# domain → HTML tag verification method → copy the `content` value out of the
# <meta name="google-site-verification" .../> tag it gives you (not the whole
# tag). Omit to skip verification entirely.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# ── App URL (used in admin notification emails) ──────────────────────────────
# Full URL of the deployed site, no trailing slash. Adds a "Review in admin →"
# button to suggestion emails. If unset the button is omitted.
APP_URL=https://yourdomain.org

# ── Resend (email notifications + confirmations) ──────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender address. onboarding@resend.dev works for testing but can
# ONLY deliver to your Resend account owner's email — not to the public.
# To send confirmation emails to submitters you must:
#   1. Verify a domain in the Resend dashboard (resend.com/domains)
#   2. Set this to an address on that domain, e.g. noreply@yourdomain.org
RESEND_FROM=onboarding@resend.dev
# Where admin notifications are sent. Also shown as the contact address on
# /privacy, and used as the reply-to on confirmation emails unless
# RESEND_REPLY_TO overrides it.
NOTIFICATION_TO=guide@example.com
# Reply-to address on confirmation emails sent to submitters. Replies from
# the public land here. Defaults to NOTIFICATION_TO if omitted.
RESEND_REPLY_TO=guide@example.com

# ── Google Places hours sync ─────────────────────────────────────────────────
# The hours/phone auto-sync (scripts/backfill-place-ids.mjs, sync-google-hours.mjs,
# and /api/cron/sync-hours) reads Google with GOOGLE_MAPS_SERVER_KEY, or
# GOOGLE_GEOCODING_API_KEY when that's unset — make sure the "Places API" is
# enabled on that key's Google Cloud project.
GOOGLE_MAPS_SERVER_KEY=your-server-places-key
#
# Shared secret protecting the cron route. Send it from your scheduler as
# `Authorization: Bearer <secret>` (or `x-cron-secret`). If unset, the route is
# unauthenticated — set it in production.
CRON_SECRET=your-long-random-cron-secret

# Shul newsletters (src/lib/newsletter.ts): the Google Apps Script in the
# guide's Gmail (scripts/newsletter-apps-script.js) sends each email to
# /api/inbound/newsletter with `Authorization: Bearer <secret>`. Unset, that
# route is closed. Generate one (openssl rand -hex 24) and put the same value
# in the script's Script properties.
NEWSLETTER_SECRET=your-long-random-newsletter-secret

# The site's own email address (tracker 100, src/lib/inboundEmail.ts): each
# community receives mail at <community>@INBOUND_EMAIL_DOMAIN, a catch-all
# at Resend, which posts each email to /api/inbound/email. The site then
# sends from that address too. The domain needs Resend's MX record (its
# Domains page gives it), so all its mail goes to Resend. The
# secret is the webhook's signing secret (whsec_…), from its page in
# Resend. Either unset, that route is closed and visitors' Reply-To stays
# the community email saved in Settings.
INBOUND_EMAIL_DOMAIN=example.org
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: a dead-man's-switch monitor pinged after every sync run, so a
# silently broken sync (revoked API key, exhausted quota, an unhandled
# exception) shows up as a missed check-in instead of just stale hours nobody
# notices. Free at healthchecks.io — create a check, set its schedule to match
# vercel.json's cron ("0 6 * * *"), and paste its ping URL here. `/fail` is
# appended automatically on a failed run. Omit to skip monitoring entirely.
CRON_HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid

# ── Rate limiting (recommended for production) ────────────────────────────────
# Public endpoints (submissions, requests, votes, travel, confirm) are rate
# limited per IP. Without these vars the app uses a best-effort in-memory limiter
# that only sees one serverless instance at a time — fine for dev, weak under a
# real flood. Set these to a free Upstash Redis database for durable, distributed
# limiting. Create one at upstash.com → Redis → REST API gives you both values.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Cloudflare Turnstile (CAPTCHA on public forms) ────────────────────────────
# Free at dash.cloudflare.com → Turnstile. The widget + server verification are
# INERT until both are set, so the app works without them. Site key is public
# (NEXT_PUBLIC_), secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Vercel Image Optimization usage kill switches ─────────────────────────────
# Two emergency levers for when a Vercel usage-threshold email says you're
# about to run out of included Image Optimization Transformations for the
# billing period — not a permanent setting either way; flip back off once the
# period resets. Both NEXT_PUBLIC_ — set in Vercel's env vars and redeploy
# (inlined at build time, a plain env var edit alone won't apply).
#
# Prefer the targeted one first: admin/community-uploaded listing photos
# (Supabase Storage) are the actual volume driver (each renders at several
# fixed sizes across the map list/card/detail/chip), while Unsplash category-
# tile photos are far fewer and the most visible thing on every home-screen
# visit — worth keeping crisp if only one has to give. Reach for the total
# switch only if the targeted one alone isn't enough.
# NEXT_PUBLIC_UPLOADED_IMAGES_UNOPTIMIZED=1

# The total switch: every photo (listing photos AND category tile photos)
# serves unoptimized instead of through Vercel's paid image optimizer — same
# fallback already used for untrusted hosts, forced on for all of them.
# NEXT_PUBLIC_IMAGES_UNOPTIMIZED=1

# Category-icon avatars are requested as small Supabase Storage-made thumbnails
# (image transformation) instead of the full photo. Set this to fall back to
# the full-size image everywhere, e.g. if Storage transformations aren't
# enabled on your Supabase plan or you hit their billing allowance.
# NEXT_PUBLIC_STORAGE_THUMBNAILS_DISABLED=1

# Where uploaded files are served from, when that isn't the project above.
# Leave unset: it defaults to NEXT_PUBLIC_SUPABASE_URL. CI sets it, because its
# database is a local one loaded from supabase/seed, whose photos still point
# at the dev project's storage.
# NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co

# ── Sentry (error tracking) ───────────────────────────────────────────────────
# Free at sentry.io → create a Next.js project → Settings → Client Keys (DSN).
# Both are the same DSN value; the SDK is disabled (no-op) until they're set,
# AND until VERCEL_ENV/NEXT_PUBLIC_VERCEL_ENV is actually 'production' (see
# src/instrumentation.ts and src/instrumentation-client.ts) — so setting these
# locally is safe: `npm run dev`, a local `npm run build && npm run start`,
# and the e2e suites never report to Sentry, only the real deployment does.
# NEXT_PUBLIC_ one covers browser errors, the unprefixed one covers
# server/edge errors caught in src/instrumentation.ts.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o000000.ingest.us.sentry.io/0000000
SENTRY_DSN=https://xxxx@o000000.ingest.us.sentry.io/0000000
# Optional: only needed to upload source maps at build time so stack traces
# show real file/line instead of minified output. Find org/project slugs in
# the Sentry project URL; create the auth token under Settings → Auth Tokens
# (needs project:releases scope). Without these the build still succeeds, it
# just skips the source-map upload.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Optional: powers `npm run sentry:check` (see AGENTS.md "Sentry") — a
# read-only look at what's currently unresolved in production. A SEPARATE
# token from SENTRY_AUTH_TOKEN above: a personal auth token (Settings →
# Auth Tokens, on your own account, not the org) with org:read, project:read,
# and event:read scopes. Without it the check just skips itself.
SENTRY_API_TOKEN=your-personal-sentry-read-token

# ── PostHog (session replay) ────────────────────────────────────────────────
# Free at posthog.com → project Settings → Project API Key. Client-only —
# same prod-only gate as Sentry (src/instrumentation-client.ts), so setting
# these locally is safe. Session Replay also needs enabling once in PostHog's
# own Settings → Recordings — the SDK config alone doesn't turn it on.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# ── Also read by the code (added Nov 20) ─────────────────────────────────────
# The canonical domain for the sitemap, robots and structured data. Unset, it
# is Vercel's production domain, or localhost for a local build.
NEXT_PUBLIC_SITE_URL=https://yourdomain.org

# The AI readers (a schedule's photo or paste, the search's question reader,
# Main dishes). Unset, each says it's off and the site works without it.
OPENAI_API_KEY=your-openai-api-key
# Optional: another model for the question reader (src/lib/readQuestion.ts
# has the default).
# READER_MODEL=
# Test servers set these to off, so a test run spends nothing on OpenAI or a
# page-drawing browser (the playwright configs). Leave them unset otherwise.
# QUESTION_READER=off
# MENU_RENDER=off

# Walks along the streets, for categories that list places "Within a walk"
# (openrouteservice.org, free tier). Unset, the nightly job skips them.
OPENROUTESERVICE_API_KEY=your-openrouteservice-key

# Sentry's cron monitors, one per job, so a job that stops running is noticed
# (src/lib/cronHeartbeat.ts). Production only, and Sentry bills monitors past
# its free allowance: check the plan before turning it on.
# SENTRY_CRON_MONITORS=on

# Local only, never in Vercel: signs you in to the admin at
# /<community>/admin?devToken=<this> without an email (`npm run dev` only; the
# route refuses in a production build). Any long random string.
DEV_ADMIN_BYPASS_SECRET=your-long-random-dev-token

# Scripts only. `npm run sync-dev-from-prod` and a script's `--prod` read the
# live database with these. They can also WRITE to it, and nothing stops
# that: never run a script with --prod --apply unless you mean to change the
# live site (AGENTS.md, "Never write to production").
# PROD_SUPABASE_URL=https://your-live-project-ref.supabase.co
# PROD_SUPABASE_SERVICE_ROLE_KEY=your-live-service-role-key

# Scripts only: scripts/restore.mjs, putting a backup into a NEW project
# (docs/backups.md). Set for that one command, never left here; it refuses
# live and the project the backup came from.
# RESTORE_URL=https://your-new-project-ref.supabase.co
# RESTORE_KEY=your-new-project-service-role-key

# Scripts only: the old-deployment clean-up (scripts/vercel-*.mjs). A token
# from vercel.com/account/tokens, the team's id and the project's name.
# VERCEL_TOKEN=your-vercel-token
# VERCEL_TEAM_ID=your-team-id
# VERCEL_PROJECT=your-project-name

# Set by Vercel itself when deployment protection lets automation through;
# the watches cron sends it on to its own calls. Nothing to set by hand.
# VERCEL_AUTOMATION_BYPASS_SECRET=
