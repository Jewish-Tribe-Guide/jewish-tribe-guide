{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // No `baseUrl` — TypeScript 6 deprecates it (hard error in 7). `paths`
    // must be relative (`./src/*`, not `src/*`) once baseUrl is gone.
    "paths": {
      "@/*": ["./src/*"]
    },
    // Explicit, because TypeScript 7 stopped auto-discovering ambient
    // `@types/*` packages that are never `import`ed anywhere (google.maps
    // is one — a pure `declare namespace google.maps {...}` ambient file,
    // never imported by name). Harmless to list explicitly on TS5/6 too,
    // so this doesn't need revisiting on the next TypeScript bump.
    "types": ["google.maps"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
